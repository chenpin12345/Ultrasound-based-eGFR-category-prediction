# Local-only bind address. Do not change to 0.0.0.0 unless you understand the privacy impact.
ISU_HOST=127.0.0.1
ISU_PORT=8000
ISU_OPEN_BROWSER=1

# Optional absolute roots. Leave these commented to use <project>/data and
# <project>/models. Uncomment only when you intentionally relocate local data.
# ISU_AI_DATA_DIR=C:\ISU_AI_KUA\data
# ISU_AI_MODELS_DIR=C:\ISU_AI_KUA\models
# ISU_AI_DATABASE_URL=sqlite:///C:/ISU_AI_KUA/data/isu_ai.sqlite3

# Upload and archive safety limits
ISU_AI_MAX_UPLOAD_BYTES=536870912
ISU_AI_MAX_METADATA_BYTES=10485760
ISU_AI_MAX_ZIP_ENTRIES=10000
ISU_AI_MAX_ZIP_UNCOMPRESSED_BYTES=2147483648
ISU_AI_MAX_ZIP_ENTRY_BYTES=536870912
ISU_AI_MAX_ZIP_COMPRESSION_RATIO=100

# Worker/resource limits
ISU_AI_CPU_WORKERS=2
ISU_AI_GPU_WORKERS=1
ISU_AI_MODEL_CACHE_SIZE=2

# setup.bat supports cpu, cu124, or cu126. CPU is the safe default.
ISU_TORCH_VARIANT=cpu

# Copy to .env only when an override is required. No secrets are supplied here.
ISU_HOST=127.0.0.1
ISU_PORT=8000
ISU_OPEN_BROWSER=1
# Default roots come from workspace-layout.json. Relative overrides use workspace root.
# ISU_AI_DATA_DIR=03_模型與影像資料/research/data
# ISU_AI_MODELS_DIR=03_模型與影像資料/research/models
# ISU_AI_CLINICAL_DIR=03_模型與影像資料/clinical
# ISU_AI_REPORTS_DIR=04_醫師報告
# ISU_AI_RUNTIME_DIR=03_模型與影像資料/runtime
# ISU_AI_REFERENCE_FEATURES_DIR=03_模型與影像資料/research/reference_features
# Do not set REQUIRE_EXISTING_DATABASES=false to hide missing migrated databases.
ISU_TORCH_VARIANT=cpu
